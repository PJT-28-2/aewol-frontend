# 이 파일을 복사해 .env.local로 만들고 값을 채운다(.env.local은 커밋되지 않는다).
#
# VITE_* 값은 빌드 결과물에 그대로 박히므로 브라우저에서 전부 보인다.
# 아래는 모두 "공개되어도 되는" 클라이언트 키다. 서버 시크릿은 여기 넣지 않는다.

# 백엔드 API 없이 목데이터로 화면만 확인할 때 true
VITE_USE_MOCK_DATA=false

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키 (소셜 로그인)
VITE_KAKAO_REST_API_KEY=

# 카카오 로그인 리다이렉트 URI. 비우면 현재 origin + /callback/kakao 로 자동 결정된다.
VITE_KAKAO_REDIRECT_URI=

# 카카오 지도 JavaScript 키 (응급 병원 지도)
VITE_KAKAO_MAP_KEY=

# TossPayments 클라이언트 키(test_ck_... 또는 live_ck_...)
# 시크릿 키(_sk_)는 백엔드 환경변수에만 두고 프론트에 절대 넣지 않는다.
# 백엔드의 시크릿 키와 반드시 같은 세트여야 한다(둘 다 테스트 또는 둘 다 라이브).
# 섞이면 INVALID_API_KEY로 결제가 실패한다.
VITE_TOSS_CLIENT_KEY=

# 1원 인증 입금자명을 은행 푸시 알림 형태로 보여주는 시연 연출(#366).
# 백엔드가 데모 서버에 붙어 있을 때만 입금자명을 내려주므로, 이 값만 켠다고
# 노출되지는 않는다. 로컬 개발/시연 빌드에서만 true.
VITE_DEMO_MODE=false
